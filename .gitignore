# macOS
.DS_Store

# Prebuilt artifacts (from prebuilds.zip + addons.zip, not committed)
frameworks/*.xcframework
addons/*.xcframework

# --- Added: wdk-setup generated output ---

# Node dependencies for the bundler + wallet packages — this is almost always
# the entire source of an unexpectedly huge diff (8,000+ files from a single
# `npm install` of this project's actual dependency set, confirmed directly).
node_modules/

# wdk-worklet-bundler's own intermediate output (generated .d.ts, working files)
.wdk/

# The full setup-script output: generated Package.swift, every addon
# xcframework, BareKit.xcframework, and the .wdk-setup-marker idempotency
# file. All of it is regenerated by `node Scripts/wdk-setup.js` /
# `swift package wdk-setup` — none of it belongs in version control.
.wdk-runtime/

# Native addon output — addons/*.xcframework already covered above;
# addons.yml is the other bundler-generated file in this directory
addons/addons.yml  
# Leftover BareKit download artifacts, if fetched manually at the repo root
# instead of through the setup script (which cleans these up itself)
barekit-prebuilds.zip
barekit-extracted/